# Firebase Configuration
# Get these values from your Firebase project settings

FIREBASE_API_KEY=your_api_key_here

# IMPORTANT: this must be the domain your app is served from, NOT
# your_project_id.firebaseapp.com. The app reverse-proxies Firebase's OAuth
# handler (/__/auth/*) through its own domain so that the handler is same-origin
# with the app. A third-party auth domain breaks sign-in on iOS in-app browsers
# and in Safari with cross-site tracking prevention.
# For local development you can leave this as your_project_id.firebaseapp.com;
# desktop browsers handle the cross-origin popup fine.
FIREBASE_AUTH_DOMAIN=your-app-domain.vercel.app

FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id
